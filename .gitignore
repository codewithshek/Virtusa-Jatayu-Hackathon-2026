# ==============================================================================
# TruthGuard — Global .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret API Keys (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
backend/.env
frontend/.env
frontend/.env.*
!.env.example
!*.env.example
!backend/.env.example

# ------------------------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
backend/.venv/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 3. Testing, Linting & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
backend/.pytest_cache/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 4. Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
*.local

# ------------------------------------------------------------------------------
# 5. Machine Learning, Embedding & Vector Store Caches
# ------------------------------------------------------------------------------
huggingface/
.cache/huggingface/
*.faiss
*.index

# ------------------------------------------------------------------------------
# 6. Operating System & Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ------------------------------------------------------------------------------
# 7. Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
